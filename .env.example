# ==============================================================================
# TECHXODIA // SUPABASE CONFIGURATION
# Fill in your Supabase project credentials from:
# https://supabase.com/dashboard/project/_/settings/api
# ==============================================================================

# Your Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co

# Your Supabase Anon Public Key (safe to use in frontend)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service Role Key (ONLY used for backend/Node CLI scripts like db:seed)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
